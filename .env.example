# ── TMDB (movie/show metadata) ────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token_here

# Max concurrent downloads (bounds sockets/FDs/disk growth). Default 2.
MOVIEHOUSE_MAX_DOWNLOADS=2

# ── Storage locations ─────────────────────────────────────────────
# Defaults: $HOME/.movies/{data,downloads,transcoded}. Override only if you
# keep media on an external drive.
#
# NOTE: unlike the keys above, these are read from the *process environment*
# only — the app does not parse them out of this file. Export them before
# launching, e.g.:
#   MOVIEHOUSE_DOWNLOAD_DIR=/Volumes/Media/downloads ./scripts/run-local.sh
#
#   MOVIEHOUSE_DATA_DIR       sled database (settings, library, download state)
#   MOVIEHOUSE_DOWNLOAD_DIR   where torrents land
#   MOVIEHOUSE_TRANSCODE_DIR  where ffmpeg writes playable copies
